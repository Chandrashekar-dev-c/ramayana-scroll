{
  "name": "ramayana-scroll",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Ramayana Scroll — the Ramayana staged as a Ramlila, inspired by Madhubani art",
  "scripts": {
    "dev": "npm run ink && vite",
    "ink": "node tools/build-ink.mjs",
    "migrate": "node tools/migrate-to-ink.mjs",
    "check": "node tools/build-ink.mjs && node tools/validate.mjs",
    "build": "npm run check && vite build && node tools/size-report.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "npm run ink && node --test tests/*.test.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "^5.0.0",
    "@fontsource/yatra-one": "^5.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "inkjs": "^2.4.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.23.0",
    "tone": "^15.1.22"
  }
}
